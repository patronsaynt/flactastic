{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--fl-accent",
      "--fl-artwork-shadow",
      "--fl-artwork-shadow-lg",
      "--fl-background",
      "--fl-badge-tint",
      "--fl-destructive",
      "--fl-divider",
      "--fl-dur-fade",
      "--fl-dur-press",
      "--fl-dur-transition",
      "--fl-ease",
      "--fl-ease-inout",
      "--fl-font-mono",
      "--fl-font-sans",
      "--fl-leading-normal",
      "--fl-leading-tight",
      "--fl-on-accent",
      "--fl-press-scale",
      "--fl-press-scale-circle",
      "--fl-quality-cd",
      "--fl-quality-hires",
      "--fl-quality-low",
      "--fl-quality-mid",
      "--fl-queued",
      "--fl-radius-card",
      "--fl-radius-lg",
      "--fl-radius-md",
      "--fl-radius-pill",
      "--fl-radius-sheet",
      "--fl-radius-sm",
      "--fl-rise-offset",
      "--fl-scrim",
      "--fl-shadow-floating",
      "--fl-shadow-menu",
      "--fl-shadow-sheet",
      "--fl-space-lg",
      "--fl-space-md",
      "--fl-space-sm",
      "--fl-space-xl",
      "--fl-space-xs",
      "--fl-space-xxl",
      "--fl-surface",
      "--fl-surface-elevated",
      "--fl-surface-hover",
      "--fl-text-body",
      "--fl-text-caption",
      "--fl-text-headline",
      "--fl-text-large-title",
      "--fl-text-micro",
      "--fl-text-primary",
