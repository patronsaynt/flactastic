      "--fl-text-title",
      "--fl-tracking-label",
      "--fl-weight-bold",
      "--fl-weight-medium",
      "--fl-weight-regular",
      "--fl-weight-semibold"
    ],
    "tokenKinds": {
      "--fl-background": "color",
      "--fl-surface": "color",
      "--fl-surface-elevated": "color",
      "--fl-surface-hover": "color",
      "--fl-divider": "color",
